{
  "schemaVersion": 1,
  "id": "debugbridge",
  "version": "${version}",
  "name": "DebugBridge 26.4 Snapshot Bridge",
  "description": "DebugBridge build for the Minecraft 26.4 snapshots, which move rendering to the RenderPearl library.",
  "authors": [
    "Weikeng Chen"
  ],
  "contact": {
    "homepage": "https://github.com/use-ai-for-mc/debugbridge",
    "sources": "https://github.com/use-ai-for-mc/debugbridge",
    "issues": "https://github.com/use-ai-for-mc/debugbridge/issues"
  },
  "license": "MIT",
  "icon": "assets/debugbridge/icon.png",
  "environment": "client",
  "mixins": [
    "debugbridge.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "com.debugbridge.fabric264.DebugBridgeMod"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": ">=26.4-"
  }
}
